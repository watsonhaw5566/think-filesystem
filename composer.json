{
  "name": "watsonhaw/think-filesystem",
  "description": "thinkphp 8.0 for filesystem oss,include Aliyun and Qiniu COS OBS",
  "type": "library",
  "require": {
    "php": "^8.0",
    "topthink/think-helper": "^3.0",
    "symfony/http-foundation": "^6.0",
    "league/flysystem": "^3.0",
    "league/flysystem-path-prefixing": "^3.3",
    "league/flysystem-read-only": "^3.3",
    "yzh52521/flysystem-oss": "^3.0",
    "yzh52521/flysystem-obs": "^3.0",
    "overtrue/flysystem-qiniu": "^3.0",
    "overtrue/flysystem-cos": "^5.0.0",
    "voku/portable-ascii": "^2.0.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "yzh52521",
      "email": "396751927@qq.com"
    },
    {
      "name": "watsonhaw",
      "email": "348748267@qq.com"
    }
  ],
  "scripts": {
    "test": "phpunit"
  },
  "autoload": {
    "psr-4": {
      "watsonhaw\\filesystem\\": "src/"
    }
