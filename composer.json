{
  "name": "watsonhaw/think-filesystem",
  "description": "thinkphp 8.0 for filesystem oss, include Aliyun and Qcloud COS",
  "type": "library",
  "require": {
    "php": "^8.0",
    "topthink/think-helper": "^3.0",
    "symfony/http-foundation": "^6.0",
    "league/flysystem": "^3.0",
    "league/flysystem-path-prefixing": "^3.3",
    "league/flysystem-read-only": "^3.3",
    "yzh52521/flysystem-oss": "^3.0",
    "overtrue/flysystem-cos": "^5.0.0",
    "voku/portable-ascii": "^2.0.0"
  },
  "require-dev": {
    "topthink/framework": "^8.0",
    "phpunit/phpunit": "^12.0",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.0"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "yzh52521",
      "email": "396751927@qq.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "watsonhaw\\filesystem\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "watsonhaw\\filesystem\\tests\\": "tests/"
    }
  },
  "extra": {
    "think": {
      "services": [
        "watsonhaw\\filesystem\\Service"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyze": "phpstan --no-progress --memory-limit=1G",
    "fix-style": "php-cs-fixer fix",
    "check-style": "php-cs-fixer fix --dry-run"
  }
}